CONFIG_ENV=Profiles/coral_google_a13.env

DEVICE_NAME=Pixel_4_XL
DEVICE_CODENAME=coral

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
EXTRA_CMDS:LD=ld.lld LLVM=1 LLVM_IAS=1

KERNEL_SOURCE=https://android.googlesource.com/kernel/msm/
KERNEL_BRANCH=android-msm-coral-4.14-android13
CLANG_SOURCE=https://github.com/llvm/llvm-project/releases/download/llvmorg-20.1.8/LLVM-20.1.8-Linux-X64.tar.xz
CLANG_BRANCH=

GCC_GNU=false

DEFCONFIG_SOURCE=
DEFCONFIG_NAME=floral_defconfig
DEFCONFIG_ORIGIN_DEFCONFIG=

KERNELSU_SOURCE=https://raw.githubusercontent.com/rsuntk/KernelSU/refs/heads/main/kernel/setup.sh
KERNELSU_BRANCH=staging/susfs-main
KERNELSU_NAME=KernelSU

SUSFS_ENABLE=true
SUSFS_FIXED=true
SUSFS_UPDATE=true

BOOT_SOURCE=https://github.com/prpjzz/android_device_google_coral-OFRP/releases/download/0.1/boot.img
ROM_TEXT=google_a13
